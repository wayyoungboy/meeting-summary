{
  "name": "meeting-summary-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && tsup src/server.ts --format cjs --platform node --target node20 --outDir dist --no-splitting --no-minify",
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "only-allow": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "yaml": "1.10.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "ajv@<7": "6.14.0",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "esbuild": "0.28.1",
      "flatted": "3.4.2",
      "js-yaml": "4.3.1",
      "minimatch@<4": "3.1.4",
      "minimatch@>=9 <10": "9.0.7",
      "nanoid@<4": "3.3.18",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <5": "4.0.4",
      "postcss": "8.5.23",
      "yaml@<2": "1.10.3"
    }
  }
}
