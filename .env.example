# Backend runtime
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=13001
CORS_ORIGINS=http://localhost:13002,http://127.0.0.1:13002
MAX_AUDIO_SIZE_MB=200

# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=24

# Set before the first start. If omitted in development, a one-time password is printed.
DEFAULT_ADMIN_PASSWORD=

# Optional storage overrides
MEETING_SUMMARY_DATA_DIR=
MEETING_SUMMARY_MODEL_DIR=
